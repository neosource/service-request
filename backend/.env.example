# Copy this file to .env and fill in the values.

# --- MongoDB ---
MONGO_URI=mongodb://srapp:srapp-pass@localhost:27017/service_requests?authSource=service_requests

# --- API server ---
PORT=3000
CORS_ORIGIN=http://localhost:8080

# --- Azure Entra ID (Azure AD) ---
# Tenant GUID for your organization
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# App registration (API) client ID
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Expected audience claim — typically api://<ENTRA_CLIENT_ID>
ENTRA_AUDIENCE=api://00000000-0000-0000-0000-000000000000

# --- Microsoft Teams integration ---
# Email/UPN of the support agent or shared mailbox to start a chat with
SUPPORT_TEAMS_CONTACT=reddyr@in.glory-global.com

# Optional: create chats via Microsoft Graph, capture chat IDs, and rename
# chat topic to "Service Request <CASE_NUMBER>".
TEAMS_GRAPH_ENABLED=false
TEAMS_TENANT_ID=00000000-0000-0000-0000-000000000000
TEAMS_CLIENT_ID=00000000-0000-0000-0000-000000000000
TEAMS_CLIENT_SECRET=replace-with-app-secret

# --- Dev only ---
# Set to "true" to bypass Entra token validation for local development.
# NEVER set this in production.
DISABLE_AUTH=false
